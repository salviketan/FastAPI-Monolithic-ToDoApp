# DB secrets
POSTGRES_USER=rootuser
POSTGRES_PASSWORD=rootpass@123

APP_DB_USER=user
APP_DB_PASSWORD=pass@123
DB_HOST=container_service_name
DB_PORT=container_bind_port
POSTGRES_DB=dbname

# # Using this creds to create alembic migration file in local
# # then use those file in docker container
# DB_HOST=localhost
# DB_PORT=host_bind_port

# APP secrets
DB_DRIVER=postgresql+asyncpg
BACKEND_CORS_ORIGINS=[]
DEBUG=False

